    {
      "id": "V24",
      "description": "Object key order discriminates UTF-16 code-unit sort from Unicode code-point sort",
      "note": "V16's three keys sort identically under both orderings, which its own note admits, so it cannot catch a sort regression. This one can: U+FF01 is a BMP key whose single code unit is 0xFF01; U+1F600 is astral and its FIRST code unit is 0xD83D. UTF-16 order puts the emoji first; code-point order puts U+FF01 first. Any switch to code-point key ordering in any implementation changes these bytes.",
      "input": {
        "evidenceId": "abc",
        "aiSystemId": "sys1",
        "humanAction": "approved",
        "humanReason": "ok",
        "capturedAt": "2026-01-01T00:00:00Z",
        "sequenceNumber": 1,
        "aiOutput": {
          "\uff01": 1,
          "\ud83d\ude00": 2,
          "a": 3
        }
